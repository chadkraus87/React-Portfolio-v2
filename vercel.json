{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "redirects": [
    {
      "source": "/notes/a-rate-limiter-that-limited-nothing",
      "destination": "/projects/petcenza",
      "permanent": true
    },
    {
      "source": "/notes/safety-that-does-not-depend-on-the-model",
      "destination": "/projects/coachrhythm",
      "permanent": true
    },
    {
      "source": "/notes/the-404-that-only-existed-in-production",
      "destination": "/#built",
      "permanent": true
    },
    {
      "source": "/notes/the-image-that-decoded-but-never-painted",
      "destination": "/#built",
      "permanent": true
    },
    {
      "source": "/notes/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/notes",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/status", "destination": "/status.json" }
  ],
  "headers": [
    {
      "source": "/(api/status|status\\.json)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://gc.zgo.at; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://chadkraus.goatcounter.com; connect-src 'self' https://chadkraus.goatcounter.com https://formspree.io; form-action 'self' https://formspree.io; frame-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
